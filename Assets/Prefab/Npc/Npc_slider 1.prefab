      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].suDungNut2
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].noiDungThoai
      value: "Ch\xE0o \u0111\u1EA1i hi\u1EC7p, ta c\xF3 th\u1EC3 gi\xFAp g\xEC ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].noiDungThoai
      value: "Gi\xE1o \u0111\u1EA7u \xE0? \u0110\u1EEBng g\u1ECDi t\xEAn n\xF3 to
        qu\xE1.\n\nNg\u01B0\u1EDDi gi\xE0 trong v\xF9ng b\u1EA3o ng\xE0y tr\u01B0\u1EDBc
        n\xF3 l\xE0 t\u01B0\u1EDBng qu\xE2n doanh. Ch\u1EBFt \u0111\xE3 l\xE2u r\u1ED3i,
        v\u1EADy m\xE0 c\u1EE9 \u0111\u1EBFn \u0111\xEAm l\xE0 nghe ti\u1EBFng gi\xE0y
        s\u1EAFt ngo\xE0i \u0111\u01B0\u1EDDng. C\u1ED9p... c\u1ED9p... c\u1ED9p...
        \u0110i \u0111\u1EC1u l\u1EAFm, nh\u01B0 c\xF3 ng\u01B0\u1EDDi \u0111ang
        tu\u1EA7n tra."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].noiDungThoai
      value: "Nh\u1EEFng ng\u01B0\u1EDDi g\u1EB7p n\xF3 \u0111\u1EC1u kh\xF4ng th\u1EC3
        tr\u1EDF v\u1EC1 r\u1ED3i \u0111\u1EA1i hi\u1EC7p \xE0, Ng\u01B0\u1EDDi ta
        n\xF3i g\u1EB7p c\xE1i b\xF3ng m\u1EB7c gi\xE1p s\xE1ng, c\u1EA7m c\xE2y
        \u0111ao l\u1EDBn, trong ch\u1EDBp m\u1EAFt n\xF3 c\xF3 th\u1EC3 xu\u1EA5t
        hi\u1EC7n tr\u01B0\u1EDBc m\u1EB7t c\u1EADu."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].noiDungThoai
      value: "ch\u1EC9 m\u1ED9t c\xE1i qu\u1EADt \u0111u\xF4i l\xE0 c\u1EA3 m\u1ED9t
        c\xE1nh r\u1EEBng b\u1ECB hoang t\xE0n, th\u01B0\u1EDDng th\xEC khi c\xF3
        \u0111\u1ED9ng \u0111\u1EA5t m\u1EA1nh m\u1ECDi ng\u01B0\u1EDDi s\u1EBD b\u1EA3
        l\xE0 do n\xF3 l\xE0m, ta c\u0169ng ch\u1EC9 bi\u1EBFt c\xF3 nhi\xEAu \u0111\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[0].tenNPC
      value: civilian
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[1].tenNPC
