      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[2].idThoai
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.textNut
      value: "Gi\xE1o \u0111\u1EA7u l\xE0 g\xEC ? "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon2.textNut
      value: "kh\xF4ng g\xEC, xin c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon1.textNut
      value: "V\u1EADy \u0111\xE3 c\xF3 ai \u0111\u1ED1i \u0111\u1EA7u v\u1EDBi n\xF3
        ch\u01B0a ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon1.textNut
      value: "c\xE1o t\u1EEB, \u0111a t\u1EA1"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon1.textNut
      value: "Ok c\xE1o t\u1EEB, \u0111a t\u1EA1"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[0].textNut1
      value: 'What is the Drillmaster? '
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[0].textNut2
      value: ' Nothing. Farewell. '
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[1].textNut1
      value: 'Has anyone ever faced him? '
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[2].textNut1
      value: Farewell, my thanks.
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.hanhDong
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon1.hanhDong
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon2.hanhDong
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon1.hanhDong
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon1.hanhDong
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[0].noiDungThoai
      value: 'Greetings, Cultivator. How may I be of assistance?

'
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[1].noiDungThoai
      value: The Drillmaster? Speak not its name so loudly! The elders say he was
        once a military general. Long since dead, yet every midnight, the clanking
        of iron boots echoes through the streets. Clank... clank... clank... Walking
        in steady steps, as if someone is still on patrol.
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoaiTiengAnh.Array.data[2].noiDungThoai
      value: Those who crossed his path never returned, good sir. They say if you
        catch a glimpse of a shadow clad in gleaming armor bearing a massive glaive...
        in the blink of an eye, he will stand right before you.
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.idThoaiTiepTheo
