    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[4].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].noiDungThoai
      value: "Ch\xE0o \u0111\u1EA1i hi\u1EC7p"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].noiDungThoai
      value: "T\xF4i ch\u1EC9 nghe ng\u01B0\u1EDDi ta k\u1EC3.\nC\xF3 m\u1ED9t m\u1EE5
        \u0111\u1EA1o s\u0129 \xE1o \u0111\u1ECF s\u1ED1ng trong \u0111\u1EA1o qu\xE1n
        b\u1ECF hoang tr\xEAn n\xFAi. T\xF3c b\u1EA1c tr\u1EAFng. Quanh ng\u01B0\u1EDDi
        h\u1EAFn l\xFAc n\xE0o c\u0169ng c\xF3 m\u1EA5y l\xE1 ph\xF9 \u0111\u1ECF
        bay l\u01A1 l\u1EEDng."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].noiDungThoai
      value: "nh\u1EEFng ng\u01B0\u1EDDi g\u1EB7p m\u1EE5 \u0111i\u1EC1u ch\u1EBFt
        kh\xF4 c\u1EA3, ta nghe n\xF3i do m\u1EE5 h\xFAt m\xE1u h\u1ECD \u0111\u1EC3
        t\u0103ng c\u01B0\u1EDDng s\u1EE9c m\u1EA1nh"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].noiDungThoai
      value: "Tr\u01B0\u1EDBc \u0111\xE2y t\u1EEBng c\xF3 1 trong ng\u0169 \u0111\u1EA1i
        hi\u1EC7p \u0111\u1EA5u v\u1EDBi \u1EA3 trong hang, \u1EA3 phi ra nh\u1EEFng
        c\xE1i t\u1EDD gi\u1EA5y g\xEC \u0111\xF3 l\xE0m ph\xE1t n\u1ED5 m\u1ED9t
        v\xF9ng l\u1EDBn, may l\xE0 \u0111\u1EA1i hi\u1EC7p \u0111\xF3 \u0111\xE3
        v\u1EBD ra t\u1EA3ng \u0111\xE1 ch\u1EB7n c\xE1i hang l\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[4].noiDungThoai
      value: "\xE0 tu v\u1EBD b\u1EA3n \u0111\u1ED3 ch\xE2u.. \xE0 nh\u1EA7m, ph\xE1i
        h\u1ECDa s\u01A1n, nh\u1EEFng g\xEC v\u1EBD ra c\xF3 th\u1EC3 h\xF4 ra th\xE0nh
        th\u1EADt"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.textNut
      value: "huy\u1EBFt ph\u1EE5 l\xE0 g\xEC ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon1.textNut
      value: "c\xF3 ai g\u1EB7p \u1EA3 ch\u01B0a ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon1.textNut
      value: "ch\u01B0a c\xF3 ai t\u1EEBng \u0111\u1ED1i \u0111\u1EA7u v\u1EDBi h\u1ECD
        \xE0 ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon1.textNut
      value: "v\u1EBD ? \u0111\u1EA1i hi\u1EC7p \u0111\xF3 tu m\xF4n ph\xE1i n\xE0o
        v\u1EADy"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon2.textNut
      value: "c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[4].luaChon1.textNut
      value: "\u0110a t\u1EA1"
      objectReference: {fileID: 0}
