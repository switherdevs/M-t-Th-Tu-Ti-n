    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].idThoai
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].noiDungThoai
      value: "\u0110\u1EA1i hi\u1EC7p c\u1EA7n g\xEC ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].noiDungThoai
      value: "N\u1EBFu c\u1EADu \u0111ang h\u1ECFi v\u1ECB t\u01B0\u1EDBng c\u01B0\u1EE1i
        ng\u1EF1a \u0111en...\nTh\xEC t\xF4i khuy\xEAn c\u1EADu \u0111\u1EEBng t\xECm.\nNg\xE0y
        tr\u01B0\u1EDBc t\xF4i t\u1EEBng \u0111i qua chi\u1EBFn tr\u01B0\u1EDDng
        ph\xEDa t\xE2y, n\u01A1i \u0111\xE3 la li\u1EC7t x\xE1c ch\u1EBFt c\u1EE7a
        nh\u1EEFng ng\u01B0\u1EDDi l\xEDnh, t\xF4i th\u1EA5y \u1EDF xa c\xF3 b\xF3ng
        d\xE1ng nh\u1EEFng k\u1EBB \u0111ang l\u1EA5y t\u01B0 trang c\u1EE7a ng\u01B0\u1EDDi
        l\xEDnh ."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].noiDungThoai
      value: "h\xF4m \u0111\xF3 tr\u1EDDi kh\xF4ng gi\xF3, v\u1EADy m\xE0 v\u1EE5t
        m\u1ED9t c\xE1i t\u1EA5t c\u1EA3 k\u1EBB \u0111\xF3 th\xE0nh jojo,  k\u1EBB
        c\u1EA7m \u0111\u1EA7u l\xE0 ng\u01B0\u1EDDi s\u1ED1ng s\xF3t v\xE0 c\u1ED1
        g\u1EAFng xem k\u1EBB t\u1EA5n c\xF4ng l\xE0 ai."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].noiDungThoai
      value: "r\u1ED3i ta ch\u1EC9 th\u1EA5y m\u1ED9t b\xF3ng ng\u01B0\u1EDDi c\u01B0\u1EE1i
        ng\u1EF1a c\u1EA7m gi\xE1o v\u1EE5t ngang, r\u1ED3i h\u1EAFn b\u1ECB ng\u01B0\u1EDDi
        \u0111\xF3 nh\u1EAFc l\xEAn cao b\u1EB1ng c\xE2y gi\xE1o \u0111\xE3 \u0111\xE2m
        xuy\xEAn ng\u01B0\u1EDDi, l\xFAc \u0111\xF3 ta ho\u1EA3ng lo\u1EA1n n\xEAn
        ch\u1EC9 bi\u1EBFt nh\u1EB9 nh\xE0ng tr\u1ED1n \u0111i"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.textNut
      value: "T\u1ED1ng tri\u1EC7u ma v\u01B0\u01A1ng l\xE0 g\xEC?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon2.textNut
      value: "kh\xF4ng g\xEC, c\xE1o t\u1EEB "
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon1.textNut
      value: "v\u1EADy sau \u0111\xF3 th\u1EBF n\xE0o"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
