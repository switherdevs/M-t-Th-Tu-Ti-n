      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].noiDungThoai
      value: "\u0110\u1EA1i hi\u1EC7p c\u1EA7n g\xEC ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].noiDungThoai
      value: "ch\xE0, \u0111\xF3 l\xE0 m\u1ED9t truy\u1EC1n thuy\u1EBFt xa x\u01B0a
        , ta nghe n\xF3i \u1EDF trong r\u1EEBng, khu v\u1EF1c \xE1m \u0111\u1EA7y
        ma kh\xED \u1EDF b\xEAn kia n\xFAi t\u1ED3n t\u1EA1i m\u1ED9t con r\u1ED3ng"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].noiDungThoai
      value: "N\xF3 to l\u1EDBn v\xE0 kh\u1EE7ng khi\u1EBFp,nh\u01B0ng n\xF3 kh\xF4ng
        gi\xFAp ng\u01B0\u1EDDi nh\u01B0 l\xE0 nh\u1EEFng con r\u1ED3ng kh\xE1c,
        m\xE0 b\u1EA5t k\xEC ai v\xE0o v\xF9ng c\u1EA5m \u0111\u1ECBa c\u1EE7a n\xF3
        s\u1EBD ch\u1EBFt kh\xF4ng to\xE0n th\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].noiDungThoai
      value: "ch\u1EC9 m\u1ED9t c\xE1i qu\u1EADt \u0111u\xF4i l\xE0 c\u1EA3 m\u1ED9t
        c\xE1nh r\u1EEBng b\u1ECB hoang t\xE0n, th\u01B0\u1EDDng th\xEC khi c\xF3
        \u0111\u1ED9ng \u0111\u1EA5t m\u1EA1nh m\u1ECDi ng\u01B0\u1EDDi s\u1EBD b\u1EA3
        l\xE0 do n\xF3 l\xE0m, ta c\u0169ng ch\u1EC9 bi\u1EBFt c\xF3 nhi\xEAu \u0111\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.textNut
      value: "Giao V\u01B0\u01A1ng \u1EDF \u0111\xE2u"
      objectReference: {fileID: 0}
