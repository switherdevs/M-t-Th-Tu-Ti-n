--- !u!114 &181372847061755494
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3083825720405224107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 634f65bdcee5d0c409a17cf2173ef3e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiThoaiRootObject: {fileID: 3083825720405224107}
  txtTenNPC: {fileID: 7508493240043103058}
  txtNoiDungThoai: {fileID: 547285926432112436}
  btnLuaChon1: {fileID: 5557725381936191373}
  txtNut1: {fileID: 7942642810723535619}
  btnLuaChon2: {fileID: 5150718046740327995}
  txtNut2: {fileID: 7915298271614271806}
  audioSource: {fileID: 0}
  amThanhThoai: {fileID: 0}
  tocDoGoChu: 0.03
  questKiemTra: {fileID: 0}
  loiThoaiDaNhanQuest: "\u0110\u1EA1i hi\u1EC7p h\xE3y gi\xFAp t\xF4i ho\xE0n th\xE0nh
    nhi\u1EC7m v\u1EE5 nhanh nh\xE9!"
  loiThoaiCamOnHoanThanh: "C\u1EA3m \u01A1n \u01A1n tr\xEAn! \u0110\u1EA1i hi\u1EC7p
    \u0111\xE3 c\u1EE9u nguy cho th\xF4n l\xE0ng ch\xFAng t\xF4i!"
  loiThoaiTamBiet: "H\u1EB9n g\u1EB7p l\u1EA1i \u0111\u1EA1i hi\u1EC7p sau!"
  danhSachCauThoai:
  - idThoai: 0
    tenNPC: "\xD4ng l\xE3o t\xECm ch\xE1u"
    noiDungThoai: "C\u1EADu c\xF3 th\u1EA5y ch\xE1u t\xF4i \u1EDF \u0111\xE2u kh\xF4ng
      ?"
    suDungNut1: 1
    luaChon1:
      textNut: "Kh\xF4ng ?"
      hanhDong: 0
      idThoaiTiepTheo: 1
      questDataToAccept: {fileID: 0}
    suDungNut2: 1
    luaChon2:
      textNut: "G\u1EB7p l\u1EA7n n\xE0o \u0111\xE2u m\xE0 bi\u1EBFt ch\xE1u \xF4ng
        ?"
      hanhDong: 0
      idThoaiTiepTheo: 1
      questDataToAccept: {fileID: 0}
  - idThoai: 1
    tenNPC: "\xD4ng l\xE3o t\xECm ch\xE1u"
    noiDungThoai: "\u0110\u1EE9a ch\xE1u t\xF4i \u0111ang b\u1ECB l\u1EA1c, l\u1EA7n
      cu\u1ED1i t\xF4i g\u1EB7p n\xF3 l\xE0 \u1EDF hang \u0111\u1ED9ng g\xEC \u0111\xF3
      ch\xE0 b\xE1 v\u1EADy n\xE8 ..."
    suDungNut1: 1
    luaChon1:
      textNut: "R\u1ED3i sao n\u1EEFa ?"
      hanhDong: 0
      idThoaiTiepTheo: 2
      questDataToAccept: {fileID: 0}
    suDungNut2: 0
    luaChon2:
      textNut: "Ti\u1EBFp t\u1EE5c"
      hanhDong: 0
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
  - idThoai: 2
    tenNPC: "\xD4ng l\xE3o t\xECm ch\xE1u"
    noiDungThoai: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i t\xECm n\xF3 kh\xF4ng ?
      nh\u01B0ng t\xF4i kh\xF4ng c\xF3 g\xEC cho c\u1EADu c\u1EA3, c\u1EA7u xin c\u1EADu
      \u0111\u1EA5y \u0111\u1EA1i hi\u1EC7p."
    suDungNut1: 1
    luaChon1:
      textNut: "T\xF4i s\u1EBD t\xECm ch\xE1u cho \xF4ng"
      hanhDong: 2
      idThoaiTiepTheo: 3
      questDataToAccept: {fileID: 0}
    suDungNut2: 1
    luaChon2:
      textNut: "C\xF3 c\xE1i l\u1ED3n"
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
  - idThoai: 3
    tenNPC: "\xD4ng l\xE3o t\xECm ch\xE1u"
    noiDungThoai: "C\u1EA3m \u01A1n \u0111\u1EA1i hi\u1EC7p nhi\u1EC1u l\u1EAFm"
    suDungNut1: 1
    luaChon1:
      textNut: ok
      hanhDong: 3
      idThoaiTiepTheo: 3
      questDataToAccept: {fileID: 0}
    suDungNut2: 1
    luaChon2:
      textNut: "C\xF3 c\xE1i l\u1ED3n"
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
