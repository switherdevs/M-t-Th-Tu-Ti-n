--- !u!114 &181372847061755494
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3083825720405224107}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 634f65bdcee5d0c409a17cf2173ef3e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiThoaiRootObject: {fileID: 3083825720405224107}
  txtTenNPC: {fileID: 7508493240043103058}
  txtNoiDungThoai: {fileID: 547285926432112436}
  btnLuaChon1: {fileID: 5557725381936191373}
  txtNut1: {fileID: 7942642810723535619}
  btnLuaChon2: {fileID: 5150718046740327995}
  txtNut2: {fileID: 7915298271614271806}
  audioSource: {fileID: 0}
  amThanhThoai: {fileID: 0}
  tocDoGoChu: 0.03
  questKiemTra: {fileID: 0}
  loiThoaiDaNhanQuest: 
  loiThoaiCamOnHoanThanh: 
  loiThoaiTamBiet: "H\u1EB9n g\u1EB7p l\u1EA1i \u0111\u1EA1i hi\u1EC7p sau!"
  danhSachCauThoai:
  - idThoai: 0
    tenNPC: "H\u1ECDa s\u0129 v\xF4 danh"
    noiDungThoai: "Haha, c\u1EADu c\xF2n qu\xE1 y\u1EBFu \u0111\u1EC3 v\u01B0\u1EE3t
      qua t\u1EA3ng \u0111\xE1 n\xE0y \u0111\u1EA5y"
    suDungNut1: 1
    luaChon1:
      textNut: "Li\xEAn quan con m\u1EB9 g\xEC m\xE0y"
      hanhDong: 3
      idThoaiTiepTheo: 1
      questDataToAccept: {fileID: 0}
    suDungNut2: 1
    luaChon2:
      textNut: "V\u1EADy l\xE0m sao \u0111\u1EC3 v\u01B0\u1EE3t qua n\xF3 ?"
      hanhDong: 3
      idThoaiTiepTheo: 1
      questDataToAccept: {fileID: 0}
  - idThoai: 1
    tenNPC: "H\u1ECDa s\u0129 v\xF4 danh"
    noiDungThoai: "C\u1EADu \xEDt nh\u1EA5t ph\u1EA3i \u0111\u1EA1t c\u1EA3nh gi\u1EDBi
      tr\xFAc c\u01A1 \u0111\u1EC3 c\xF3 th\u1EC3 ph\xE1 h\u1EE7y \u0111\u01B0\u1EE3c
      n\xF3"
    suDungNut1: 1
    luaChon1:
      textNut: "Th\u1EB1ng \u0111i\xEAn n\xE0o l\u1EA1i \u0111\u1EC3 t\u1EA3ng \u0111\xE1
        n\xE0y \u1EDF \u0111\xE2y"
      hanhDong: 0
      idThoaiTiepTheo: 2
      questDataToAccept: {fileID: 0}
    suDungNut2: 0
    luaChon2:
      textNut: "ok t\u1EA1m bi\u1EC7t"
      hanhDong: 2
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
  - idThoai: 2
    tenNPC: "H\u1ECDa s\u0129 v\xF4 danh"
    noiDungThoai: "sao c\u1EADu l\u1EA1i n\xF3i v\u1EADy, c\xF4ng s\u1EE9c c\u1EE7a
      ng\u01B0\u1EDDi ta d\u1EF1ng n\xF3 \u0111\u1EC3 c\u1EADu \u0111\u01B0\u1EE3c
      s\u1ED1ng b\xECnh y\xEAn \u0111\xE1y"
    suDungNut1: 1
    luaChon1:
      textNut: "ai c\u01A1 ?"
      hanhDong: 0
      idThoaiTiepTheo: 3
      questDataToAccept: {fileID: 0}
    suDungNut2: 0
    luaChon2:
      textNut: 
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
  - idThoai: 3
    tenNPC: "H\u1ECDa s\u0129 v\xF4 danh"
    noiDungThoai: "Ng\u0169 \u0111\u1EA1i hi\u1EC7p, 5 ng\u01B0\u1EDDi tu ti\xEAn
      v\xE0 c\xF3 k\u1EF9 n\u0103ng ki\u1EBFm v\xF5 m\u1EA1nh vcl \u0111\xE3 d\u01B0ng
      n\xF3 l\xEAn \u0111\u1EC3 kh\xF4ng cho nh\u1EEFng th\u1EE9 nguy hi\u1EC3m v\xE0o
      \u0111\xE2y"
    suDungNut1: 1
    luaChon1:
      textNut: "th\u1EE9 \u0111\xF3 l\xE0 g\xEC ?"
      hanhDong: 0
      idThoaiTiepTheo: 4
      questDataToAccept: {fileID: 0}
    suDungNut2: 0
    luaChon2:
      textNut: "C\xF3 c\xE1i l\u1ED3n"
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
  - idThoai: 4
    tenNPC: "H\u1ECDa s\u0129 v\xF4 danh"
    noiDungThoai: "kh\xF4ng bi\u1EBFt n\u1EEFa, h\u1ECFi ng\u01B0\u1EDDi kh\xE1c
      \u0111i."
    suDungNut1: 1
    luaChon1:
      textNut: "C\xE1i  \u0111@t m\u1EB9 m\xE0y"
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
    suDungNut2: 1
    luaChon2:
      textNut: ok skibidi
      hanhDong: 3
      idThoaiTiepTheo: 0
      questDataToAccept: {fileID: 0}
