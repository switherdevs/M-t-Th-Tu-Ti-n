    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[4].suDungNut2
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[5].suDungNut1
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].noiDungThoai
      value: "Ch\xE0o ch\xE0ng trai tr\u1EBB, t\xF4i th\u1EA5y \u1EDF m\u1ED9t ti\u1EC1m
        n\u0103ng l\u1EDBn \u0111\u1EA5y"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].noiDungThoai
      value: "N\xE0o l\xE0m g\xEC m\xE0 th\xF4 l\u1ED7 th\u1EBF, ta ch\u1EC9 mu\u1ED1n
        gi\xFAp c\u1EADu th\xF4i, c\u1EADu gi\u1ECFi ki\u1EBFm nh\u01B0ng \u0111\u1EC3
        th\u1EF1c hi\u1EC7n \u0111i\u1EC1u c\u1EADu mu\u1ED1n th\xEC ch\u01B0a \u0111\u1EE7"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].noiDungThoai
      value: "C\u1EADu h\xE3y theo con \u0111\u01B0\u1EDDng tu ti\xEAn, v\xEC c\u1EADu
        c\xF3 k\u1EF9 n\u0103ng d\xF9ng ki\u1EBFm s\u1EB5n n\xEAn c\u1EADu s\u1EBD
        theo m\xF4n ph\xE1i ki\u1EBFm tu."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].noiDungThoai
      value: "\u0110\xF3n nh\u1EADn s\u1EE9c m\u1EA1nh c\u1EE7a m\xECnh \u0111i,
        ta mong c\u1EADu s\u1EBD tr\u1EDF th\xE0nh m\u1ED9t \u0111\u1EA1i hi\u1EC7p
        tr\u01B0\u1EE3ng ngh\u0129a"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[4].noiDungThoai
      value: "Haha, ta v\u1EEBa m\u1EDF l\u1ED1i cho con \u0111\u01B0\u1EDDng tu
        ti\xEAn c\u1EE7a c\u1EADu, \u0111\xE2y ch\u1EC9 l\xE0 khai ph\xE1, c\xF2n
        m\u1EA1nh hay y\u1EBFu l\xE0 \u1EDF c\u1EADu. c\xE1o t\u1EEB"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[5].noiDungThoai
      value: "\xD4ng \u1EA5y v\u1EEBa \u0111\xE1nh v\xE0o vai, x\xE9m vai g\xE3y
        r\u1ED3i."
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon1.textNut
      value: "l\xE3o v\u1EEBa b\u1EA3o ti\u1EC1m n\u0103ng ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[0].luaChon2.textNut
      value: "v\u1EADy th\xEC \u0111\xE3 sao ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon1.textNut
      value: "v\u1EADy ta ph\u1EA3i l\xE0m sao"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[1].luaChon2.textNut
      value: "v\u1EADy th\xEC \u0111\xE3 sao ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon1.textNut
      value: "L\xE0 sao ?"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[2].luaChon2.textNut
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
      propertyPath: danhSachCauThoai.Array.data[3].luaChon1.textNut
      value: "\xD4ng v\u1EEBa l\xE0m g\xEC t\xF4i \u0111\u1EA5y !"
      objectReference: {fileID: 0}
    - target: {fileID: 181372847061755494, guid: 9f6e5e2a1632c6b459dbe1a443ea9764, type: 3}
