  tenNhiemVu: "Hang \u0110\u1ED9ng B\u1EABy Nh\u1EC7n"
  loiThoaiNhanQuest: "\u0110i s\xE2u v\xE0o l\u1ED1i nh\u1ECF Thanh Tr\xFAc L\xE2m
    c\xF3 m\u1ED9t b\u1EA7y qu\xE1i nh\u1EC7n \u0111\u1ED9c nhi\u1EC5m ma kh\xED
    \u0111ang ch\u0103ng t\u01A1 b\u1EABy ng\u01B0\u1EDDi \u0111i \u0111\u01B0\u1EDDng.
    R\u1EA5t nhi\u1EC1u th\u01B0\u01A1ng nh\xE2n \u0111\xE3 b\u1ECB b\u1ECDn ch\xFAng
    v\xE2y b\u1EAFt. \u0110\u1EA1i hi\u1EC7p h\xE3y gi\xFAp ti\xEAu di\u1EC7t b\u1EA7y
    nh\u1EC7n \u0111\u1ED9c n\xE0y!"
  loiThoaiDangLam: "M\u1ED9c kh\xED nhi\u1EC5m \u0111\u1ED9c t\u1EEB t\u01A1 nh\u1EC7n
    r\u1EA5t nguy hi\u1EC3m. \u0110\u1EA1i hi\u1EC7p nh\u1EDB c\u1EA9n th\u1EADn
    v\xE0 ti\xEAu di\u1EC7t \u0111\u1EE7 8 con nh\u1EC7n \u0111\u1ED9c trong r\u1EEBng
    m\u1ED9c nh\xE9"
  loiThoaiHoanThanh: "Th\u1EADt may m\u1EAFn khi c\xF3 v\u1ECB \u0111\u1EA1o h\u1EEFu
    ra tay! \u0110\u01B0\u1EDDng x\xE1 giao th\u01B0\u01A1ng qua Thanh Tr\xFAc L\xE2m
    gi\u1EDD \u0111\xE2y \u0111\xE3 b\u1EDBt \u0111i m\u1ED9t m\u1ED1i nguy hi\u1EC3m
    l\u1EDBn"
