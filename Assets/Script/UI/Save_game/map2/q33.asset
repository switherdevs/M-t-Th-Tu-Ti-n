  idQuest: 44
  tenNhiemVu: "M\u1ED9c Tinh Bi\u1EBFn D\u1EA1ng"
  loaiQuest: 0
  idQuaiCanDiet: 4
  soLuongBoXuongCanDiet: 75
  idDoiTuongCanGiaiCuu: 0
  soLuongCanGiaiCuu: 1
  loiThoaiNhanQuest: "Ma kh\xED u u\u1EA5t \u0111\xE3 x\xE2m nh\u1EADp v\xE0o t\u1EADn
    r\u1EC5 c\u1EE7a c\xE1c c\u1ED5 th\u1EE5 ng\xE0n n\u0103m, bi\u1EBFn ch\xFAng
    th\xE0nh nh\u1EEFng qu\xE1i c\xE2y \u0103n th\u1ECBt ng\u01B0\u1EDDi di \u0111\u1ED9ng!
    Ch\xFAng d\xF9ng r\u1EC5 \u0111\u1ED9c qu\u1EA5n ch\u1EB7t v\xE0 b\xF3p n\xE1t
    n\u1EA1n nh\xE2n. Mau ch\u1EB7t \u0111\u1EE9t m\u1ED1i h\u1ECDa m\u1ED9c tinh
    n\xE0y!"
  loiThoaiDangLam: "L\u1EDBp v\u1ECF c\xE2y nhi\u1EC5m ma kh\xED c\u1EE9ng nh\u01B0
    s\u1EAFt th\xE9p v\xE0 c\u1EF1c k\u1EF3 hung h\xE3n. \u0110\u1EA1o h\u1EEFu h\xE3y
    t\u1EADp trung linh l\u1EF1c v\xE0o \u0111\xF2n \u0111\xE1nh \u0111\u1EC3 \u0111\u1EADp
    tan l\u1EDBp gi\xE1p c\u1EE7a l\u0169 m\u1ED9c tinh bi\u1EBFn d\u1EA1ng"
  loiThoaiHoanThanh: "L\u0169 qu\xE1i c\xE2y \u0111\xE3 bi\u1EBFn th\xE0nh tro b\u1EE5i!
    Ma kh\xED t\xE0n d\u01B0 tr\xEAn c\xE1c g\u1ED1c c\u1ED5 th\u1EE5 \u0111ang tan
    bi\u1EBFn, \u0111\u1EA1o h\u1EEFu qu\u1EA3 l\xE0 c\xF3 b\u1EA3n l\u0129nh phi
    th\u01B0\u1EDDng."
