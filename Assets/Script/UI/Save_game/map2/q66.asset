  loiThoaiNhanQuest: "T\xEAn T\u01B0\u1EDBng T\xE0 Ma \u0111\u1EE9ng \u0111\u1EA7u
    s\u01A1n kh\u1EA9u \u0111\xE3 b\u1ECB ma kh\xED chi\u1EBFm h\u1EEFu ho\xE0n to\xE0n,
    bi\u1EBFn th\xE0nh m\u1ED9t con qu\xE1i v\u1EADt kh\xE1t m\xE1u! H\u1EAFn d\xF9ng
    s\xE1t kh\xED \xE1p ch\u1EBF v\xE0 ch\u1EC9 huy to\xE0n b\u1ED9 ma qu\u1EF7 trong
    khu v\u1EF1c. Ch\u1EC9 c\xF3 di\u1EC7t t\xEAn \u0110\u1EA7u S\u1ECF n\xE0y m\u1EDBi
    d\u1EADp t\u1EAFt \u0111\u01B0\u1EE3c tai h\u1ECDa"
  loiThoaiDangLam: "T\xEAn Th\u1EE7 L\u0129nh T\xE0 Ma s\u1EDF h\u1EEFu v\xF5 ngh\u1EC7
    ma \u0111\u1EA1o c\u1EF1c k\u1EF3 c\u01B0\u1EDDng \u0111\u1EA1i c\xF9ng gi\xE1p
    ma kh\xED h\u1ED9 th\xE2n. \u0110\u1EA1o h\u1EEFu h\xE3y d\u1ED3n to\xE0n b\u1ED9
    s\u1EE9c m\u1EA1nh \u0111\u1EC3 ti\xEAu di\u1EC7t t\xEAn Tr\xF9m S\u01A1n Kh\u1EA9u
    n\xE0y"
  loiThoaiHoanThanh: "T\xEAn \u0110\u1EA7u S\u1ECF ng\xE3 xu\u1ED1ng, to\xE0n b\u1ED9
    c\u0103n c\u1EE9 t\xE0 ma s\u1EE5p \u0111\u1ED5! \u0110\u1EA1o h\u1EEFu ch\xEDnh
    l\xE0 \u0111\u1EA1i c\u1EE9u tinh c\u1EE7a v\xF9ng \u0111\u1EA5t U Minh U T\u1ED1i
    n\xE0y"
