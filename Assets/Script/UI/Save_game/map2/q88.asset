  tenNhiemVu: "Hang \u0110\u1ED9ng B\u1EABy Nh\u1EC7n"
  loaiQuest: 0
  idQuaiCanDiet: 2
  soLuongBoXuongCanDiet: 500
  idDoiTuongCanGiaiCuu: 0
  soLuongCanGiaiCuu: 1
  loiThoaiNhanQuest: "B\xEAn trong hang \u0111\u1ED9c U Minh, ma kh\xED \u0111\xE3
    bi\u1EBFn \u0111\xE1m nh\u1EC7n r\u1EEBng th\xE0nh qu\xE1i th\xFA kh\u1ED5ng
    l\u1ED3 \u0103n th\u1ECBt ng\u01B0\u1EDDi! R\u1EA5t nhi\u1EC1u tu s\u0129 \u0111i
    qua \u0111\xE3 b\u1ECB h\xFAt kh\xF4 m\xE1u th\u1ECBt. H\xE3y d\u1EA5n th\xE2n
    v\xE0o s\xE0o huy\u1EC7t, tuy\u1EC7t di\u1EC7t m\u1ED1ng \u0111\u1ED9c n\xE0y"
  loiThoaiDangLam: "\u0110\u1ECDc t\xE0 trong hang nh\u1EC7n c\u1EF1c k\u1EF3 kinh
    k\u1ECBch, t\u01A1 c\u1EE7a ch\xFAng c\xF3 th\u1EC3 \u0103n m\xF2n c\u1EA3 linh
    l\u1EF1c! \u0110\u1EA1o h\u1EEFu nh\u1EDB gi\u1EEF kho\u1EA3ng c\xE1ch v\xE0
    ti\xEAu di\u1EC7t \u0111\u1EE7 s\u1ED1 l\u01B0\u1EE3ng b\u1EABy nh\u1EC7n \u0111\u1ED9c
    nh\xE9"
  loiThoaiHoanThanh: "M\xF9i h\xF4i th\u1ED1i c\u1EE7a t\xE0 t\u01A1 \u0111\xE3 nh\u1EA1t
    \u0111i r\u1ED3i... \u0110\u1EA1o h\u1EEFu th\u1EF1c s\u1EF1 \u0111\xE3 san b\u1EB1ng
    c\xE1i s\xE0o huy\u1EC7t t\xE0 \xE1c \u0111\xF3! \u0110\xE2y l\xE0 ph\u1EA7n
    th\u01B0\u1EDFng x\u1EE9ng \u0111\xE1ng cho s\u1EF1 m\u1EA1o hi\u1EC3m c\u1EE7a
    ng\xE0"
