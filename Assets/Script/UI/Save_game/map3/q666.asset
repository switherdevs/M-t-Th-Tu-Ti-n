  idQuest: 777
  tenNhiemVu: "Tr\u1EA3m \u0110ao Ti\u1EC1n Tr\u1EA3m"
  loiThoaiNhanQuest: "L\u1EDDi tho\u1EA1i tr\u01B0\u1EDBc khi nh\u1EADn quest: \"L\u1EF1c
    l\u01B0\u1EE3ng n\xF2ng c\u1ED1t c\u1EE7a Doanh Tr\u1EA1i S\u01A1n T\u1EB7c l\xE0
    \u0111\xE1m s\u01A1n t\u1EB7c c\u1EA7m \u0111ao hung t\u1EE3n. B\u1ECDn ch\xFAng
    c\u01B0\u1EDBp b\xF3c kh\u1EAFp c\xE1c ng\xF4i l\xE0ng ngo\u1EA1i th\xE0nh v\xE0
    s\u1EB5n s\xE0ng xu\u1ED1ng tay v\u1EDBi b\u1EA5t k\u1EF3 ai. \u0110\u1EA1i hi\u1EC7p
    h\xE3y \u0111\u1EBFn tr\u01B0\u1EDBc c\u1ED5ng doanh tr\u1EA1i c\xE0n qu\xE9t
    b\u1ECDn ch\xFAng"
  loiThoaiDangLam: "\u0110\xE1m ti\u1EC1n phong c\u1EA7m \u0111ao r\u1EA5t \u0111\xF4ng
    v\xE0 hi\u1EBFu chi\u1EBFn. Ng\xE0i h\xE3y gi\u1EEF kho\u1EA3ng c\xE1ch v\xE0
    ti\xEAu di\u1EC7t \u0111\u1EE7 15 t\xEAn s\u01A1n t\u1EB7c d\u0169ng m\xE3nh
    n\xE0y nh\xE9!"
  loiThoaiHoanThanh: "B\u1ECDn s\u01A1n t\u1EB7c b\u1EA1o ng\u01B0\u1EE3c \u0111\xE3
    b\u1ECB tr\u1EEBng tr\u1ECB th\xEDch \u0111\xE1ng! Kh\xED th\u1EBF c\u01B0\u1EDBp
    b\xF3c c\u1EE7a ch\xFAng \u0111\xE3 b\u1ECB \u0111\u1EA1i hi\u1EC7p \u0111\xE1nh
    tan t\xE0nh."
