  loiThoaiNhanQuest: "Binh \u0111o\xE0n Tr\u1EA3m \u0110ao Ma Binh \u2014 l\u1EF1c
    l\u01B0\u1EE3ng c\u1EADn v\u1EC7 hung t\xE0n nh\u1EA5t c\u1EE7a Luy\u1EC7n Ng\u1EE5c
    \u0111ang c\xE0n qu\xE9t! M\u1ED7i \u0111ao c\u1EE7a ch\xFAng \u0111\u1EC1u mang
    theo ma kh\xED thi\xEAu r\u1EE5i linh h\u1ED3n. Mu\u1ED1n ti\u1EBFn g\u1EA7n
    Ma Qu\xE2n, ng\u01B0\u01A1i bu\u1ED9c ph\u1EA3i t\xE0n s\xE1t s\u1EA1ch \u0111\xE1m
    \u0111ao th\u1EE7 n\xE0y"
  loiThoaiDangLam: "S\xE1t kh\xED t\u1EEB \u0111\u1EA1i \u0111ao c\u1EE7a l\u0169
    ma binh \u0111ang \xE1p ch\u1EBF c\u1EA3 v\xF9ng kh\xF4ng gian! \u0110\u1EA1o
    h\u1EEFu ch\u1EDB l\u01A1i tay, h\xE3y vung ki\u1EBFm ti\xEAu di\u1EC7t \u0111\u1EE7
    s\u1ED1 l\u01B0\u1EE3ng ma binh c\u1EADn v\u1EC7"
  loiThoaiHoanThanh: "\u0110\u1ED9i qu\xE2n \u0111ao th\u1EE7 kh\xE9t ti\u1EBFng
    nh\u1EA5t Luy\u1EC7n Ng\u1EE5c \u0111\xE3 b\u1ECB \u0111\u1EADp tan! Giang h\u1ED3
    ch\u1EA5n \u0111\u1ED9ng tr\u01B0\u1EDBc s\u1EE9c m\u1EA1nh v\u0129 \u0111\u1EA1i
    c\u1EE7a \u0111\u1EA1o h\u1EEFu"
